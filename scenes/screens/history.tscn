[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://src/ui/screens/history.gd" id="1_hi"]
[ext_resource type="PackedScene" path="res://scenes/components/top_bar.tscn" id="2_tb"]
[ext_resource type="PackedScene" path="res://scenes/components/button.tscn" id="3_btn"]

[node name="History" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_hi")

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 12

[node name="TopBar" parent="Margin/Content" instance=ExtResource("2_tb")]
title = "Match history"
show_back = true
show_coins = false

[node name="HistoryPanel" type="PanelContainer" parent="Margin/Content"]
theme_type_variation = "Card"

[node name="HistoryBody" type="VBoxContainer" parent="Margin/Content/HistoryPanel"]
theme_override_constants/separation = 8

[node name="HistoryHeading" type="Label" parent="Margin/Content/HistoryPanel/HistoryBody"]
theme_type_variation = "Heading"
text = "Completed matches"

[node name="HistoryList" type="VBoxContainer" parent="Margin/Content/HistoryPanel/HistoryBody"]
theme_override_constants/separation = 8

[node name="HistoryHint" type="Label" parent="Margin/Content/HistoryPanel/HistoryBody"]
theme_type_variation = "Caption"
autowrap_mode = 3
text = "No completed matches yet — play a game first."

[node name="ReloadRow" type="HBoxContainer" parent="Margin/Content"]
theme_override_constants/separation = 8

[node name="ReloadButton" parent="Margin/Content/ReloadRow" instance=ExtResource("3_btn")]
custom_minimum_size = Vector2(0, 40)
variant = 1
text = "Refresh"

[node name="Spacer" type="Control" parent="Margin/Content"]
size_flags_vertical = 3
