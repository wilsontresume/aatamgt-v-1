# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=mysql://root@127.0.0.1:3306/aatamgt_dev
TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/aatamgt_test

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# --- Logging ---
LOG_LEVEL=debug
