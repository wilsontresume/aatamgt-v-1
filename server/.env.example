# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=mysql://root@127.0.0.1:3306/aatamgt_dev
TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/aatamgt_test

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# --- Logging ---
LOG_LEVEL=debug

# --- Virtual coin economy (Phase 7) ---
COINS_REGISTRATION_BONUS=1000
COINS_DAILY_LOGIN_BONUS=100
COINS_REWARDED_AD_BONUS=500
COINS_REWARDED_AD_STANDARD=100

# --- Ads (Phase 8) ---
# Provider abstraction: 'stub' (built-in, no SDK) | 'admob' | 'unity_ads'.
ADS_PROVIDER=stub
# Ad unit IDs come from the environment — never from source code.
ADS_REWARDED_UNIT_ID=
ADS_INTERSTITIAL_UNIT_ID=
# Rewarded ad sessions must be redeemed within this window.
ADS_SESSION_TTL_SECONDS=300
# Interstitial frequency rules (server-side, changeable without a release).
ADS_INTERSTITIAL_AFTER_WINS=3
ADS_INTERSTITIAL_AFTER_LOSSES=5
# Minimum completed matches between two interstitials.
ADS_INTERSTITIAL_COOLDOWN_MATCHES=2

# --- TLS (optional, enables HTTPS when both are set) ---
# TLS_CERT_PATH=./dev-certs/dev-cert.pem
# TLS_KEY_PATH=./dev-certs/dev-key.pem
