// AATAMGT platform schema — Phase 2 (common platform, no game rules).
// MySQL 8 / MariaDB compatible. All identifiers are quoted by Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  username      String     @unique
  passwordHash  String
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  isGuest       Boolean    @default(false)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  royalPassExpiresAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  profile         Profile?
  wallets         Wallet[]
  refreshTokens   RefreshToken[]
  matchPlayers    MatchPlayer[]
  matchMoves      MatchMove[]
  dailyRewards    DailyReward[]
  notifications   Notification[]
  adSessions      AdSession[]
  adShows         AdShow[]
  friendshipsSent Friendship[]   @relation("friend_requester")
  friendshipsGot  Friendship[]   @relation("friend_addressee")
  challengesSent  Challenge[]    @relation("challenge_challenger")
  challengesGot   Challenge[]    @relation("challenge_invitee")
  leaderboardRows LeaderboardEntry[]
  auditLogs       AdminAuditLog[]
  userCosmetics   UserCosmetic[]
  analyticsEvents AnalyticsEvent[]
  gameRatings     GameRating[]
  ratingEvents    RatingEvent[]
  purchases       Purchase[]
  matchmakingTickets MatchmakingTicket[]
  moderationNotesWritten  ModerationNote[] @relation("ModerationNoteAuthor")
  moderationNotesReceived ModerationNote[] @relation("ModerationNoteTarget")
  socialAccounts SocialAccount[]

  @@index([status])
  @@index([createdAt])
}

/// A linked Facebook/Google identity. One row per provider subject; a user
/// may hold one identity per provider (google + facebook). Linking a social
/// identity to a guest account upgrades it — the guest keeps its progress
/// and stops being disposable.
model SocialAccount {
  id        String   @id @default(cuid())
  provider  String   @db.VarChar(16) // "google" | "facebook"
  subject   String   @db.VarChar(191) // stable provider-side user id
  email     String?  @db.VarChar(190)
  name      String?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatarKey   String   @default("default")
  countryCode String?  @db.VarChar(2)
  bio         String?  @db.Text
  level       Int      @default(1)
  xp          Int      @default(0)
  rating      Int      @default(1000)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  gamesPlayed Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Economy
// ---------------------------------------------------------------------------

enum WalletTxType {
  REGISTRATION_BONUS
  DAILY_LOGIN
  REWARDED_AD
  MATCH_REWARD
  PURCHASE
  COSMETIC_PURCHASE
  ROYAL_PASS_BONUS
  ADMIN_ADJUSTMENT
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String
  currency      String   @default("COIN") @db.VarChar(8)
  balance       Int      @default(0)
  lockedBalance Int      @default(0)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([userId, currency])
  @@index([balance])
}

model WalletTransaction {
  id             String        @id @default(cuid())
  walletId       String
  amount         Int
  balanceAfter   Int
  type           WalletTxType
  refType        String?       @db.VarChar(64)
  refId          String?       @db.VarChar(64)
  idempotencyKey String?       @unique
  memo           String?       @db.VarChar(255)
  createdAt      DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum GameStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

model Game {
  id                     String     @id @default(cuid())
  key                    String     @unique
  name                   String
  slug                   String     @unique
  description            String?    @db.Text
  minPlayers             Int        @default(2)
  maxPlayers             Int        @default(2)
  status                 GameStatus @default(ACTIVE)
  rulesVersion           Int        @default(1)
  requiresAuthoritativeState Boolean @default(true)
  /// Home-screen carousel order (lower first). Content-only; never
  /// affects rules or matchmaking.
  displayOrder           Int        @default(0)
  /// Optional JSON config. Phase E stores visual board theme here
  /// (boardTheme: colors + asset ids) — never geometry or rules.
  config                 Json?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  matches GameMatch[]
}

/// Admin-managed virtual-coin stake tier. Players read active tiers from
/// GET /tiers; admins CRUD via /admin/tiers. GameMatch.tierId stays a
/// snapshot string (no FK) so historical matches survive tier edits.
model Tier {
  id                 String   @id @db.VarChar(64)
  name               String   @db.VarChar(64)
  gameKey            String?  @db.VarChar(64)
  description        String?  @db.VarChar(255)
  /// Display-only hex color (e.g. "#cd7f32"). Never used for economy.
  displayColor       String?  @db.VarChar(32)
  /// Optional TIER_ART asset id (GameAsset.id, no FK — assets may be
  /// replaced while historical tiers keep referencing the lineage).
  artAssetId         String?  @db.VarChar(64)
  entryCostCoins     Int      @default(0)
  rewardMultiplierBp Int      @default(10000)
  active             Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, displayOrder])
  @@index([gameKey, active])
}

// ---------------------------------------------------------------------------
// Content (Phase E) — admin-managed assets + published manifests
// ---------------------------------------------------------------------------

enum AssetType {
  HOME_BACKGROUND
  GAME_BACKGROUND
  GAME_CARD
  GAME_ICON
  BOARD_TEXTURE
  BOARD_BACKGROUND
  PIECE_ART
  TIER_ART
  BANNER
  DECORATION
}

/// One immutable uploaded image. Replacing an asset creates a NEW row in
/// the same lineage (version+1) — the old row and its file stay intact so
/// a published manifest can never lose its bytes. Files live in storage
/// under a randomized key; binaries never enter MySQL.
model GameAsset {
  id              String    @id @default(cuid())
  /// null = global asset (e.g. HOME_BACKGROUND / BANNER for the shell).
  gameKey         String?   @db.VarChar(64)
  type            AssetType
  /// Randomized storage key, e.g. "ab/cd0123....png". Never a user filename.
  storageKey      String    @unique @db.VarChar(191)
  originalName    String    @db.VarChar(255)
  mimeType        String    @db.VarChar(64)
  byteSize        Int
  width           Int?
  height          Int?
  /// sha256 hex of the file bytes — client cache validation + integrity.
  checksum        String    @db.VarChar(64)
  active          Boolean   @default(true)
  version         Int       @default(1)
  /// Shared id across replacements: lineage root is the first upload.
  lineageId       String    @db.VarChar(64)
  note            String?   @db.VarChar(255)
  createdByUserId String?   @db.VarChar(64)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([gameKey, type, active])
  @@index([lineageId, version])
  @@index([type, active])
}

enum PublicationStatus {
  PUBLISHED
  SUPERSEDED
}

/// Immutable snapshot of a validated content manifest. "Current" = the
/// single PUBLISHED row (publish flips the previous row to SUPERSEDED in
/// the same transaction, so clients never observe a half-published state).
/// Rollback re-publishes an older manifest as a NEW version.
model ContentPublication {
  id                String            @id @default(cuid())
  version           Int               @unique
  status            PublicationStatus @default(PUBLISHED)
  /// Frozen manifest JSON exactly as clients received it.
  manifest          Json
  /// sha256 of the canonical manifest JSON.
  checksum          String            @db.VarChar(64)
  note              String?           @db.VarChar(255)
  /// Set when this version was created by a rollback (source version).
  rolledBackFrom    Int?
  publishedByUserId String?           @db.VarChar(64)
  /// Denormalized actor name so history survives user deletion.
  publishedByName   String            @default("system") @db.VarChar(64)
  createdAt         DateTime          @default(now())

  @@index([status, version])
}

// ---------------------------------------------------------------------------
// Matches (server-authoritative envelope; no rules engine yet)
// ---------------------------------------------------------------------------

enum MatchStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  CANCELLED
}

enum MatchMode {
  CASUAL
  RANKED
  PRIVATE
}

enum MatchResult {
  PENDING
  WIN
  LOSS
  DRAW
  ABANDONED
}

model GameMatch {
  id           String      @id @default(cuid())
  gameId       String
  gameKey      String
  status       MatchStatus @default(PENDING)
  mode         MatchMode   @default(CASUAL)
  stakeCoins   Int         @default(0)
  /// Reward multiplier (basis points) snapshotted from the Tier when the
  /// match was created. Settlement prefers this so later tier edits can
  /// never retroactively change an ongoing match's payout. Null only on
  /// matches created before this column existed (fallback: live tier).
  rewardMultiplierBp Int?
  tierId       String?
  stateVersion Int         @default(0)
  serverState  Json?
  createdByUserId String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  game    Game          @relation(fields: [gameId], references: [id])
  players MatchPlayer[]
  moves   MatchMove[]

  @@index([gameKey, status])
  @@index([status, createdAt])
  @@index([createdByUserId])
}

model MatchPlayer {
  id        String      @id @default(cuid())
  matchId   String
  userId    String?
  seat      Int
  isAi      Boolean     @default(false)
  aiName    String?
  color     String?     @db.VarChar(32)
  team      Int?
  result    MatchResult @default(PENDING)
  score     Int         @default(0)
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?

  match     GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moves     MatchMove[]

  @@unique([matchId, seat])
  @@index([userId])
}

model MatchMove {
  id             String        @id @default(cuid())
  matchId        String
  seq            Int
  matchPlayerId  String?
  userId         String?
  payload        Json
  stateHash      String?       @db.VarChar(64)
  serverAt       DateTime      @default(now())

  match       GameMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPlayer MatchPlayer? @relation(fields: [matchPlayerId], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, seq])
  @@index([userId])
}

enum MatchmakingStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

model MatchmakingTicket {
  id             String              @id @default(cuid())
  userId         String
  gameKey        String
  tierId         String
  status         MatchmakingStatus  @default(WAITING)
  matchedMatchId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameKey, tierId, status])
  @@index([userId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model DailyReward {
  id          String   @id @default(cuid())
  userId      String
  rewardDate  DateTime @db.Date
  streakDay   Int
  rewardCoins Int
  claimedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardDate])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Ads (Phase 8)
// ---------------------------------------------------------------------------

enum AdSessionStatus {
  OPEN
  REDEEMED
}

/// Server-issued opportunity to watch a rewarded ad. Coins are granted
/// only against a session the backend itself minted — a bare client
/// callback can never pay out.
model AdSession {
  id         String           @id @default(cuid())
  userId     String
  provider   String           @db.VarChar(32)
  tier       String           @db.VarChar(16)
  nonce      String           @unique @db.VarChar(64)
  status     AdSessionStatus  @default(OPEN)
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Audit record of interstitial presentations — powers the show-rate
/// cooldown so interstitials never fire after every match.
model AdShow {
  id      String   @id @default(cuid())
  userId  String
  kind    String   @db.VarChar(16)
  matchId String?  @db.VarChar(64)
  shownAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, shownAt])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requester User @relation("friend_requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("friend_addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// Shareable game challenge: created by a challenger, optionally aimed at a
/// specific invitee (open codes keep inviteeId null). The match row is only
/// created when the invitee accepts — the challenge itself is just a code.
model Challenge {
  id          String         @id @default(cuid())
  code        String         @unique
  gameKey     String         @db.VarChar(64)
  tierId      String?
  challengerId String
  inviteeId   String?
  matchId     String?
  status      ChallengeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  challenger User @relation("challenge_challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  invitee    User? @relation("challenge_invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([challengerId, status])
  @@index([status, expiresAt])
}

model Notification {
  id       String    @id @default(cuid())
  userId   String
  type     String    @db.VarChar(64)
  title    String
  body     String?   @db.Text
  data     Json?
  readAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  ALL_TIME
}

model LeaderboardEntry {
  id        String            @id @default(cuid())
  key       String            @db.VarChar(128)
  userId    String
  gameKey   String?           @db.VarChar(64)
  period    LeaderboardPeriod @default(ALL_TIME)
  score     Int               @default(0)
  rank      Int               @default(0)
  updatedAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([key, score])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String   @db.VarChar(128)
  targetType   String?  @db.VarChar(64)
  targetId     String?  @db.VarChar(64)
  data         Json?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// Staff moderation notes on a user account (Phase C): author, timestamp,
/// target. Append-only for now; never carries credentials.
model ModerationNote {
  id           String   @id @default(cuid())
  targetUserId String
  authorUserId String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  target User @relation("ModerationNoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  author User @relation("ModerationNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([authorUserId, createdAt])
}

/// Runtime platform configuration (Phase 15). Admin-editable overrides;
/// unset keys fall back to the environment defaults in configuration.ts.
model SystemConfig {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cosmetics (Phase 12) — server-owned inventory, no real-money purchases.
// ---------------------------------------------------------------------------

enum CosmeticCategory {
  BOARD_SKIN
  PROFILE_PICTURE
  PROFILE_FRAME
  VICTORY_ANIMATION
  CAPTURE_ANIMATION
}

enum CosmeticTier {
  FREE
  PREMIUM
}

model Cosmetic {
  id               String           @id @default(cuid())
  key              String           @unique @db.VarChar(64)
  category         CosmeticCategory
  name             String           @db.VarChar(120)
  description      String?          @db.VarChar(255)
  tier             CosmeticTier     @default(FREE)
  price            Int              @default(0)
  grantedByDefault Boolean          @default(false)
  sortOrder        Int              @default(0)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  userCosmetics UserCosmetic[]

  @@index([category, active])
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  cosmeticId String
  source     String   @default("claim") @db.VarChar(16)
  equipped   Boolean  @default(false)
  grantedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId, equipped])
}

// ---------------------------------------------------------------------------
// Competitive ranking (Phase 14)
// ---------------------------------------------------------------------------

model Season {
  id           String        @id @default(cuid())
  key          String        @unique
  name         String
  startsAt     DateTime      @default(now())
  endsAt       DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  gameRatings  GameRating[]
  ratingEvents RatingEvent[]

  @@index([isActive])
}

// One rating row per player, per game, per season. The rating itself is
// written only from the server's match-completion transaction.
model GameRating {
  id          String   @id @default(cuid())
  seasonId    String
  userId      String
  gameKey     String   @db.VarChar(64)
  rating      Int      @default(1000)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  gamesPlayed Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId, gameKey])
  @@index([seasonId, gameKey, rating])
}

// One row per (match, player): the unique key is the duplicate-submission
// guard — a match result can be applied at most once per participant.
model RatingEvent {
  id           String   @id @default(cuid())
  seasonId     String
  matchId      String
  userId       String
  gameKey      String   @db.VarChar(64)
  result       String   @db.VarChar(8)
  reason       String   @db.VarChar(32)
  ratingBefore Int
  delta        Int
  ratingAfter  Int
  createdAt    DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 13 — In-app purchases (platform store transactions)
// ---------------------------------------------------------------------------

enum StorePlatform {
  GOOGLE_PLAY
  APPLE_APP_STORE
}

enum PurchaseState {
  PENDING
  GRANTED
  REFUNDED
  REVOKED
  EXPIRED
}

// Verified store transaction. The unique (platform, purchaseToken) pair
// is the idempotency guard: a store token can only ever be processed
// once, no matter how many times the client resubmits it.
model Purchase {
  id           String        @id @default(cuid())
  userId       String
  productKey   String        @db.VarChar(128)
  platform     StorePlatform
  purchaseToken String
  orderId      String?       @db.VarChar(128)
  state        PurchaseState @default(PENDING)
  coinAmount   Int           @default(0)
  passDays     Int           @default(0)
  // Royal Pass grant snapshots: which expiry this grant produced and
  // what it was before it, so a refund can roll the pass back exactly.
  entitlementPreviousExpiresAt DateTime?
  entitlementExpiresAt         DateTime?
  verifiedAt    DateTime?
  grantedAt     DateTime?
  revokedAt     DateTime?
  revocationReason String?    @db.VarChar(64)
  rawVerification   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, purchaseToken])
  @@index([userId, createdAt])
  @@index([state, createdAt])
}

enum DevStoreState {
  PENDING
  PURCHASED
  CANCELED
}

// Development-only store simulator: rows stand in for transactions
// Google Play would issue. Endpoints that read or write it are gated
// off in production (config `iap.devStore` is forced false there).
model DevStorePurchase {
  id            String         @id @default(cuid())
  purchaseToken String         @unique
  orderId       String         @unique
  productKey    String         @db.VarChar(128)
  userId        String
  state         DevStoreState  @default(PURCHASED)
  issuedAt      DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, issuedAt])
}

// ---------------------------------------------------------------------------
// Analytics (privacy-conscious product metrics)
// ---------------------------------------------------------------------------
// Append-only event log. No PII columns: never store emails, usernames,
// IPs, user agents or device fingerprints. `installId` is a random UUID
// minted client-side (not derived from any hardware identifier) and is
// only ever compared for equality; `userId` is the internal cuid.
// Server-authoritative events are written automatically; client-reported
// events are restricted to an allow-list in the analytics service.

enum AnalyticsSubjectType {
  INSTALL
  USER
}

enum AnalyticsEventType {
  install
  first_launch
  registration
  guest_conversion
  session_start
  session_end
  match_completed
  first_match
  rematch
  game_selected
  ai_match_completed
  friend_request
  challenge_created
  challenge_accepted
  share
  rewarded_ad_started
  rewarded_ad_completed
  interstitial_displayed
  royal_pass_purchase
  coin_purchase
  cosmetic_purchase
}

model AnalyticsEvent {
  id         String              @id @default(cuid())
  type       AnalyticsEventType
  userId     String?
  installId  String?             @db.VarChar(64)
  sessionId  String?             @db.VarChar(64)
  gameKey    String?             @db.VarChar(64)
  platform   String?             @db.VarChar(32)
  version    String?             @db.VarChar(32)
  data       Json?
  dedupeKey  String?             @unique
  createdAt  DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([installId, createdAt])
  @@index([sessionId])
}

// One row per subject per UTC day, upserted (INSERT … ON DUPLICATE KEY
// UPDATE) on every recorded event. DAU/MAU and D1..D30 retention are
// exact "was active on day D" counts derived from this table, which
// keeps the summary endpoint a handful of group-by queries instead of
// a full scan of AnalyticsEvent.

model AnalyticsActiveDay {
  id          String              @id @default(cuid())
  subjectType AnalyticsSubjectType
  subjectId   String              @db.VarChar(64)
  day         DateTime            @db.Date

  @@unique([subjectType, subjectId, day])
  @@index([subjectType, day])
}
